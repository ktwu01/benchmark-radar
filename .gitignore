__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
node_modules/
dist/
build/
*.egg-info/
.env
out/
/site/data/radar.json
/site/data/radar-bootstrap.json
/site/data/radar-trends.json
/site/feed.xml
/site/sitemap.xml
# Generated by `benchmark-radar export` and published by the Pages build. Built
# artifacts like radar.json: committing them would let a stale ranking be
# reviewed as if it were source, and the registry is the source.
/site/data/leaderboard.json
/site/data/leaderboard.csv
/site/data/leaderboard.md
/site/data/leaderboard-badge.json
/site/data/records-badge.json

# Derived by `benchmark-radar classify` from the snapshots, which are the
# source. Committing it would let a stale or partially backfilled set of
# levels be reviewed as if a human had written them. Pages regenerates the
# store before publishing; the MVP's null extractor makes no external calls.
/data/kw_bench_classifications.jsonl

# Commit emails harvested by `benchmark-radar authors --author-emails` (issue
# #156). `git log` publishes an author's address and most contributors do not
# realise it, so a committed list of them is a spam and doxxing vector whatever
# the intent. The survey itself carries public professional signals only and is
# safe to share; this file is not.
benchmark-author-contacts.csv
benchmark-author-contacts.json

# Local tool working dirs. graphify-out/ holds per-run analysis caches and
# graph dumps from the graphify skill; .claude/ holds the local
# audit-progressive-disclosure skill that is not part of the registry source.
.gstack/
.DS_Store
.worktrees/
graphify-out/
.claude/

# Generated by `benchmark-radar normalize-external` from the committed crawl
# CSVs in data/leaderboard_snapshots/. Same rule as radar.json: the snapshot
# CSVs are the source, and a committed derivation could be reviewed as if it
# were one. tests/test_external_catalog.py pins the counts and the invariants,
# so the evidence is checked in even though the payload is not. The contents are
# matched with a trailing `*` rather than the directory itself, so the one
# hand-edited file below can be re-included: git cannot re-include a file whose
# parent directory is excluded.
/data/external/*
# identity.yml is the exception: it is hand-edited source, not a derivation, so
# it is committed and reviewed. identity_candidates.yml beside it is generated
# and stays ignored like the rest of the derived catalog.
!/data/external/identity.yml
# Same exception, same reason: reviewed identity for llm-stats benchmarks with
# no donor record anywhere else in the corpus, written by hand from a crawl and
# never regenerated from one.
!/data/external/llm_stats_identity_overrides.yml

# Written by the same `benchmark-radar normalize-external` run as the ignored
# catalog above, from the same committed crawl CSVs, and rebuilt by pages.yml on
# every deploy. They were committed anyway, so the published site served whatever
# the last commit happened to carry while the CSVs beside them moved on. That is
# the failure the radar.json rule already names: a stale derivation reviewed as
# if it were source. The build is deterministic, so nothing is lost by dropping
# them; `normalize-external` reproduces all 1,172 shards byte for byte.
/site/data/benchmark-index.json
/site/data/benchmarks/
# Same rule as the shards above: the static benchmark pages are generated by
# `benchmark-radar normalize-external` from the committed crawl CSVs and rebuilt
# by pages.yml on every deploy. Committing them would let a stale page be
# reviewed as if it were source.
/site/benchmarks/
# Static app pages are rebuilt by `benchmark-radar classify` from the
# committed snapshot and curated data layers. Keep them derived for the same
# reason as the benchmark pages: the generator and inputs are reviewed, not a
# stale HTML copy.
/site/leaderboard/
# One page per collection day, written by the same `classify` run from the
# committed snapshots. The whole tree is replaced on every build, so a
# committed copy would be a stale brief reviewed as if it were the day's
# report, and a day removed from the history would keep its page.
/site/blog/
/site/trends/
/site/explore/
/site/cli/
/site/cite/
/site/rubric/
# Complete checksummed archive generated by `build-data-release` for installed
# CLI clients. Pages rebuilds it from the committed snapshots and crawl inputs;
# committing it would review a binary derivation instead of its sources.
/site/data/cli/
