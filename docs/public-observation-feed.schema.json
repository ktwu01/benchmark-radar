{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ktwu01.github.io/benchmark-radar/schema/public-observation-feed-v1.json",
  "title": "Benchmark Radar public observation feed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "generated_at",
    "observations",
    "health"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "health": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/health"
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "source_id",
        "title",
        "url",
        "published_at",
        "discovered_at",
        "event_kind",
        "categories",
        "metrics",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "discovered_at": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string"
        },
        "event_kind": {
          "enum": [
            "discussed",
            "shared",
            "released",
            "updated"
          ]
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "rationale": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "primary_artifact_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supporting_observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supportingObservation"
          }
        }
      }
    },
    "supportingObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "url",
        "published_at",
        "metrics"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "primary_artifact_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "ok",
        "item_count"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "item_count": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
